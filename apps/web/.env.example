NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
ATLAS_ALLOWED_ORIGINS=https://your-atlas-domain.example
ATLAS_ENABLE_HSTS=false
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
BREVO_API_KEY=your-brevo-api-key
BREVO_INITIAL_RECRUITMENT_TEMPLATE_ID=your-brevo-template-id
BREVO_RECRUITMENT_FOLLOW_UP_1_TEMPLATE_ID=your-brevo-follow-up-1-template-id
BREVO_RECRUITMENT_FOLLOW_UP_2_TEMPLATE_ID=your-brevo-follow-up-2-template-id

# VendreSonCommerce: manual sends remain off unless explicitly enabled in production.
VSC_MANUAL_SEND_ENABLED=false
VSC_OVH_TENANT_ID=your-vsc-tenant-uuid
VSC_OVH_SMTP_PASSWORD=your-vsc-ovh-mailbox-password
VSC_UNSUBSCRIBE_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters
VSC_PUBLIC_BASE_URL=https://your-vsc-production-domain.example

# VSC SMS pilot adapter only; no route/scheduler is installed. Keep disabled.
VSC_SMS_DISPATCH_ENABLED=false
